{
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|svg|ico|jpg|jpeg|webp|json|wasm))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/courses/daa",
      "destination": "/courses/daa/",
      "permanent": false
    },
    {
      "source": "/courses/atp",
      "destination": "/courses/atp/",
      "permanent": false
    },
    {
      "source": "/courses/dsa",
      "destination": "/courses/dsa/",
      "permanent": false
    },
    {
      "source": "/course/daa",
      "destination": "/courses/daa/",
      "permanent": false
    },
    {
      "source": "/course/atp",
      "destination": "/courses/atp/",
      "permanent": false
    },
    {
      "source": "/course/dsa",
      "destination": "/courses/dsa/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/courses/assets/:path*",
      "destination": "https://saclearn-daa.vercel.app/assets/:path*"
    },
    {
      "source": "/courses/atp/assets/:path*",
      "destination": "https://sac-learn-atp.vercel.app/assets/:path*"
    },
    {
      "source": "/courses/atp/:file(.*\\.(?:png|svg|ico|jpg|jpeg|webp|json|wasm))",
      "destination": "https://sac-learn-atp.vercel.app/:file"
    },
    {
      "source": "/courses/atp/",
      "destination": "https://sac-learn-atp.vercel.app/"
    },
    {
      "source": "/courses/atp",
      "destination": "https://sac-learn-atp.vercel.app/"
    },
    {
      "source": "/courses/atp/(.*)",
      "destination": "https://sac-learn-atp.vercel.app/$1"
    },
    {
      "source": "/course/atp/assets/:path*",
      "destination": "https://sac-learn-atp.vercel.app/assets/:path*"
    },
    {
      "source": "/course/atp/:file(.*\\.(?:png|svg|ico|jpg|jpeg|webp|json|wasm))",
      "destination": "https://sac-learn-atp.vercel.app/:file"
    },
    {
      "source": "/course/atp/",
      "destination": "https://sac-learn-atp.vercel.app/"
    },
    {
      "source": "/course/atp",
      "destination": "https://sac-learn-atp.vercel.app/"
    },
    {
      "source": "/course/atp/(.*)",
      "destination": "https://sac-learn-atp.vercel.app/$1"
    },
    {
      "source": "/courses/dsa/assets/:path*",
      "destination": "https://atlas-sac.vercel.app/assets/:path*"
    },
    {
      "source": "/courses/dsa/sac_learn_logo.png",
      "destination": "https://atlas-sac.vercel.app/sac_learn_logo.png"
    },
    {
      "source": "/courses/dsa/",
      "destination": "https://atlas-sac.vercel.app/"
    },
    {
      "source": "/courses/dsa",
      "destination": "https://atlas-sac.vercel.app/"
    },
    {
      "source": "/courses/dsa/(.*)",
      "destination": "https://atlas-sac.vercel.app/$1"
    },
    {
      "source": "/course/dsa/assets/:path*",
      "destination": "https://atlas-sac.vercel.app/assets/:path*"
    },
    {
      "source": "/course/dsa/sac_learn_logo.png",
      "destination": "https://atlas-sac.vercel.app/sac_learn_logo.png"
    },
    {
      "source": "/course/dsa/",
      "destination": "https://atlas-sac.vercel.app/"
    },
    {
      "source": "/course/dsa",
      "destination": "https://atlas-sac.vercel.app/"
    },
    {
      "source": "/course/dsa/(.*)",
      "destination": "https://atlas-sac.vercel.app/$1"
    },
    {
      "source": "/courses/daa/assets/:path*",
      "destination": "https://saclearn-daa.vercel.app/assets/:path*"
    },
    {
      "source": "/courses/daa/:file(.*\\.(?:png|svg|ico|jpg|jpeg|webp|json|wasm))",
      "destination": "https://saclearn-daa.vercel.app/:file"
    },
    {
      "source": "/courses/daa/",
      "destination": "https://saclearn-daa.vercel.app/"
    },
    {
      "source": "/courses/daa",
      "destination": "https://saclearn-daa.vercel.app/"
    },
    {
      "source": "/courses/daa/(.*)",
      "destination": "https://saclearn-daa.vercel.app/$1"
    },
    {
      "source": "/course/daa/assets/:path*",
      "destination": "https://saclearn-daa.vercel.app/assets/:path*"
    },
    {
      "source": "/course/daa/:file(.*\\.(?:png|svg|ico|jpg|jpeg|webp|json|wasm))",
      "destination": "https://saclearn-daa.vercel.app/:file"
    },
    {
      "source": "/course/daa/",
      "destination": "https://saclearn-daa.vercel.app/"
    },
    {
      "source": "/course/daa",
      "destination": "https://saclearn-daa.vercel.app/"
    },
    {
      "source": "/course/daa/(.*)",
      "destination": "https://saclearn-daa.vercel.app/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
